# DealFlow360 — Production Environment Template
# Copy this file to .env and configure your local or cloud values.
# NEVER commit production credentials to version control.

# Server Port
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=development

# PostgreSQL Connection String (Primary Authoritative Source of Truth)
# Example: postgresql://postgres:postgrespassword@localhost:5432/dealflow360?sslmode=disable
DATABASE_URL="postgresql://username:password@localhost:5432/dealflow360?schema=public"

# Redis Cache & Distributed Lock Connection URL (ioredis)
# Example: redis://localhost:6379 or rediss://... for TLS
REDIS_URL="redis://localhost:6379"

# JSON Web Token Secret Key (Must be at least 32 characters in production)
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"

# Observability Log Format: text | json (Use json for Datadog/CloudWatch)
LOG_FORMAT=text

# Rate Limiting Window Configuration (Optional overrides)
# RATE_LIMIT_AUTH_MAX=15
# RATE_LIMIT_MUTATION_MAX=120

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  sales_rep
  sales_manager
  finance
  admin
}

enum CustomerTier {
  bronze
  silver
  gold
}

enum ProductCategory {
  hardware
  services
  subscription
}

enum BillingCycle {
  monthly
  quarterly
  yearly
}

enum ApprovalLevelType {
  none
  sales_manager
  sales_manager_then_finance
}

enum ApprovalDecision {
  pending
  approved
  rejected
  returned_for_revision
}

enum QuotationStatus {
  draft
  pending_approval
  approved
  under_negotiation
  confirmed
  split_pending
  backorder
  cancelled
}

enum SubscriptionStatus {
  active
  paused
  cancelled
}

enum InvoiceStatus {
  unpaid
  paid
  partially_paid
  refunded
}

enum AlertType {
  stalled_deal
  discount_anomaly
  delivery_slippage
}

// ============================================================
// USERS & CUSTOMERS
// ============================================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  team         String?
  createdAt    DateTime @default(now()) @map("created_at")

  quotations Quotation[]
  approvals  Approval[]  @relation("AssignedApprover")
  auditLogs  AuditLog[]

  @@map("users")
}

model Customer {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String?      @map("password_hash")
  tier         CustomerTier @default(bronze)
  currency     String       @default("USD")
  createdAt    DateTime     @default(now()) @map("created_at")

  quotations Quotation[]

  @@map("customers")
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id              String          @id @default(uuid())
  name            String
  category        ProductCategory
  description     String?
  basePrice       Decimal         @map("base_price") @db.Decimal(12, 2)
  unit            String          @default("each")
  taxPct          Decimal         @default(0) @map("tax_pct") @db.Decimal(5, 2)
  isSubscription  Boolean         @default(false) @map("is_subscription")
  status          String          @default("active")
  createdAt       DateTime        @default(now()) @map("created_at")

  variants          ProductVariant[]
  priceLists        PriceList[]
  warehouseStock    WarehouseStock[]
  subscriptionPlans SubscriptionPlan[]
  quotationLines    QuotationLine[]
  upsellAsBase      UpsellRule[]     @relation("BaseProduct")
  upsellAsSuggested UpsellRule[]     @relation("SuggestedProduct")

  @@map("products")
}

model ProductVariant {
  id         String  @id @default(uuid())
  productId  String  @map("product_id")
  attribute  String
  value      String
  extraPrice Decimal @default(0) @map("extra_price") @db.Decimal(12, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model PriceList {
  id            String       @id @default(uuid())
  productId     String       @map("product_id")
  tier          CustomerTier
  currency      String       @default("USD")
  priceRule     String       @default("no_adjustment") @map("price_rule")
  resolvedPrice Decimal      @map("resolved_price") @db.Decimal(12, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, tier, currency])
  @@map("price_lists")
}

// ============================================================
// DISCOUNT RULES
// ============================================================

model DiscountTierCeiling {
  tier           CustomerTier @id
  maxDiscountPct Decimal      @map("max_discount_pct") @db.Decimal(5, 2)

  @@map("discount_tier_ceilings")
}

model CategoryDiscountCeiling {
  category       ProductCategory @id
  maxDiscountPct Decimal         @map("max_discount_pct") @db.Decimal(5, 2)

  @@map("category_discount_ceilings")
}

model ApprovalChainRule {
  id              String            @id @default(uuid())
  minOveragePct   Decimal           @map("min_overage_pct") @db.Decimal(5, 2)
  maxOveragePct   Decimal?          @map("max_overage_pct") @db.Decimal(5, 2)
  requiredLevel   ApprovalLevelType @map("required_level")

  @@map("approval_chain_rules")
}

// ============================================================
// WAREHOUSES
// ============================================================

model Warehouse {
  id                 String   @id @default(uuid())
  name               String
  shippingCostWeight Decimal  @default(1.0) @map("shipping_cost_weight") @db.Decimal(6, 2)
  createdAt          DateTime @default(now()) @map("created_at")

  stock        WarehouseStock[]
  fulfillments Fulfillment[]

  @@map("warehouses")
}

model WarehouseStock {
  id                String  @id @default(uuid())
  warehouseId       String  @map("warehouse_id")
  productId         String  @map("product_id")
  inStock           Int     @default(0) @map("in_stock")
  reserved          Int     @default(0)
  replenishmentRule String? @map("replenishment_rule")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@map("warehouse_stock")
}

// ============================================================
// SUBSCRIPTIONS
// ============================================================

model SubscriptionPlan {
  id                String       @id @default(uuid())
  productId         String       @map("product_id")
  cycle             BillingCycle
  amount            Decimal      @db.Decimal(12, 2)
  prorationRule     String?      @map("proration_rule")
  cancellationRule  String?      @map("cancellation_rule")
  createdAt         DateTime     @default(now()) @map("created_at")

  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotationLines  QuotationLine[]
  orderSubscriptions OrderSubscription[]

  @@map("subscription_plans")
}

model UpsellRule {
  id                  String   @id @default(uuid())
  baseProductId        String   @map("base_product_id")
  suggestedProductId   String   @map("suggested_product_id")
  coPurchaseScore      Decimal  @default(0) @map("co_purchase_score") @db.Decimal(6, 3)
  isPromoted           Boolean  @default(false) @map("is_promoted")
  minMarginPct         Decimal  @default(0) @map("min_margin_pct") @db.Decimal(5, 2)

  baseProduct      Product @relation("BaseProduct", fields: [baseProductId], references: [id], onDelete: Cascade)
  suggestedProduct Product @relation("SuggestedProduct", fields: [suggestedProductId], references: [id], onDelete: Cascade)

  @@map("upsell_rules")
}

// ============================================================
// QUOTATIONS
// ============================================================

model Quotation {
  id               String          @id @default(uuid())
  code             String          @unique
  customerId       String          @map("customer_id")
  repId            String          @map("rep_id")
  status           QuotationStatus @default(draft)
  blendedRiskScore Decimal?        @default(0) @map("blended_risk_score") @db.Decimal(6, 2)
  blendedRiskLevel String?         @default("low") @map("blended_risk_level")
  stalledSince     DateTime?       @map("stalled_since")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at")

  customer            Customer              @relation(fields: [customerId], references: [id])
  rep                 User                  @relation(fields: [repId], references: [id])
  lines               QuotationLine[]
  approvals           Approval[]
  fulfillments        Fulfillment[]
  invoices            Invoice[]
  negotiationRequests NegotiationRequest[]
  dealHealthAlerts    DealHealthAlert[]

  @@map("quotations")
}

model QuotationLine {
  id                 String   @id @default(uuid())
  quotationId        String   @map("quotation_id")
  productId          String   @map("product_id")
  variantId          String?  @map("variant_id")
  subscriptionPlanId String?  @map("subscription_plan_id")
  qty                Int      @default(1)
  unitPrice          Decimal  @map("unit_price") @db.Decimal(12, 2)
  discountPct        Decimal  @default(0) @map("discount_pct") @db.Decimal(5, 2)
  categoryLimitPct   Decimal? @map("category_limit_pct") @db.Decimal(5, 2)
  overagePct         Decimal  @default(0) @map("overage_pct") @db.Decimal(5, 2)
  isUpsellAdd        Boolean  @default(false) @map("is_upsell_add")
  marginDelta        Decimal? @map("margin_delta") @db.Decimal(12, 2)
  createdAt          DateTime @default(now()) @map("created_at")

  quotation          Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id])
  subscriptionPlan   SubscriptionPlan?   @relation(fields: [subscriptionPlanId], references: [id])
  fulfillments       Fulfillment[]
  orderSubscription  OrderSubscription?
  negotiationRequests NegotiationRequest[]

  @@map("quotation_lines")
}

// ============================================================
// APPROVALS & AUDIT
// ============================================================

model Approval {
  id           String            @id @default(uuid())
  quotationId  String            @map("quotation_id")
  level        ApprovalLevelType
  assignedTo   String?           @map("assigned_to")
  decision     ApprovalDecision  @default(pending)
  reason       String?
  decidedAt    DateTime?         @map("decided_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  approver  User?     @relation("AssignedApprover", fields: [assignedTo], references: [id])

  @@map("approvals")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  userId     String?  @map("user_id")
  action     String
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ============================================================
// FULFILLMENT
// ============================================================

model Fulfillment {
  id               String   @id @default(uuid())
  quotationId      String   @map("quotation_id")
  quotationLineId  String   @map("quotation_line_id")
  warehouseId      String   @map("warehouse_id")
  qtyFulfilled     Int      @map("qty_fulfilled")
  isBackorder      Boolean  @default(false) @map("is_backorder")
  isManualOverride Boolean  @default(false) @map("is_manual_override")
  estimatedCost    Decimal? @map("estimated_cost") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  quotation     Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationLine QuotationLine @relation(fields: [quotationLineId], references: [id], onDelete: Cascade)
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])

  @@map("fulfillments")
}

// ============================================================
// BILLING / SUBSCRIPTIONS ON AN ORDER
// ============================================================

model OrderSubscription {
  id                 String              @id @default(uuid())
  quotationLineId    String              @unique @map("quotation_line_id")
  subscriptionPlanId String              @map("subscription_plan_id")
  status             SubscriptionStatus  @default(active)
  nextBillDate       DateTime            @map("next_bill_date") @db.Date
  createdAt          DateTime            @default(now()) @map("created_at")

  quotationLine    QuotationLine      @relation(fields: [quotationLineId], references: [id], onDelete: Cascade)
  subscriptionPlan SubscriptionPlan   @relation(fields: [subscriptionPlanId], references: [id])
  prorationEvents  ProrationEvent[]

  @@map("order_subscriptions")
}

model ProrationEvent {
  id                  String   @id @default(uuid())
  orderSubscriptionId String   @map("order_subscription_id")
  changeType          String   @map("change_type")
  oldQty              Int?     @map("old_qty")
  newQty              Int?     @map("new_qty")
  proratedAmount      Decimal  @map("prorated_amount") @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  orderSubscription OrderSubscription @relation(fields: [orderSubscriptionId], references: [id], onDelete: Cascade)

  @@map("proration_events")
}

// ============================================================
// INVOICES
// ============================================================

model Invoice {
  id          String        @id @default(uuid())
  code        String        @unique
  quotationId String        @map("quotation_id")
  amount      Decimal       @db.Decimal(12, 2)
  status      InvoiceStatus @default(unpaid)
  dueDate     DateTime?     @map("due_date") @db.Date
  paidAt      DateTime?     @map("paid_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  quotation Quotation     @relation(fields: [quotationId], references: [id])
  lines     InvoiceLine[]

  @@map("invoices")
}

model InvoiceLine {
  id              String  @id @default(uuid())
  invoiceId       String  @map("invoice_id")
  quotationLineId String? @map("quotation_line_id")
  lineType        String  @map("line_type")
  description     String
  amount          Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_lines")
}

// ============================================================
// CUSTOMER NEGOTIATION
// ============================================================

model NegotiationRequest {
  id                     String   @id @default(uuid())
  quotationId            String   @map("quotation_id")
  quotationLineId        String?  @map("quotation_line_id")
  customerComment        String?  @map("customer_comment")
  counterDiscountPct     Decimal? @map("counter_discount_pct") @db.Decimal(5, 2)
  requestedDeliveryDate  DateTime? @map("requested_delivery_date") @db.Date
  status                 String   @default("open")
  createdAt              DateTime @default(now()) @map("created_at")

  quotation     Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationLine QuotationLine? @relation(fields: [quotationLineId], references: [id])

  @@map("negotiation_requests")
}

// ============================================================
// DEAL HEALTH
// ============================================================

model DealHealthAlert {
  id          String    @id @default(uuid())
  quotationId String    @map("quotation_id")
  alertType   AlertType @map("alert_type")
  detail      String
  flaggedAt   DateTime  @default(now()) @map("flagged_at")
  actionTaken String?   @map("action_taken")
  resolvedAt  DateTime? @map("resolved_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("deal_health_alerts")
}
